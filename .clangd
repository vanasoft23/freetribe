CompileFlags:
  # GCC's static analyzer is still used by firmware builds, but clang does not
  # understand this driver-only option while parsing files for the editor.
  Remove: [-fanalyzer]

Diagnostics:
  UnusedIncludes: None

---

If:
  PathMatch: [.*ddr_bringup\.c$, ^cpu/lib/FreeRTOS-Kernel/portable/GCC/AM1802/portISR\.c$]
Diagnostics:
  Suppress: [err_non_asm_stmt_in_naked_function]

---

# So that unity header gets seen by clangd
If:
  PathMatch: ^cpu/tests/native/.*
CompileFlags:
  CompilationDatabase: build/native-tests

---

If:
  PathMatch: ^dsp/.*
CompileFlags:
  Add: [-IC:/apps/dev/bfin-elf/bfin-elf/include]
