{
    "version": "2.0.0",
    "tasks": [

        // -------------------------------------------------------------
        //
        // Scripts / Miscellaneous
        //
        // -------------------------------------------------------------

        {
            "label": "execute freetribe via MIDI",
            "type": "shell",
            "command": "python \"../hacktribe/scripts/execute_freetribe.py\" \"build/kernel/kernel.bin\" \"6- UMC404HD 192k MIDI In 0\" \"6- UMC404HD 192k MIDI Out 0\"",
            "group": {
                "kind": "test",
                // "isDefault": true
            }
        },
        {
            "label": "execute bootloader via MIDI",
            "type": "shell",
            "command": "python \"../hacktribe/scripts/execute_freetribe.py\" \"build/bootloader/bootloader.bin\" \"6- UMC404HD 192k MIDI In 0\" \"6- UMC404HD 192k MIDI Out 0\"",
            "group": {
                "kind": "test",
                // "isDefault": true
            }
        },
        {
            "label": "send freetribe executable through USB (dfu-util)",
            "type": "shell",
            "command": "dfu-util -d e2fb:1802 --download \"build/kernel/kernel.bin\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test"
            }
        },
        
        // -------------------------------------------------------------
        //
        // CMake Configure
        //
        // -------------------------------------------------------------

        {
            "label": "CMake: configure firmware",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "firmware-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: configure monosynth",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "monosynth-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: configure native tests",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "native-tests-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/cpu/tests/native"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },

        // -------------------------------------------------------------
        //
        // CMake Build
        //
        // -------------------------------------------------------------

        {
            "label": "CMake: build bootloader",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "bootloader",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: configure firmware"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build kernel (monosynth)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "monosynth-kernel",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: configure monosynth"
            ],
            "group": {
                "kind": "build",
            },
        },
        {
            "label": "build debug_bringup",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "debug-bringup"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: configure firmware"
            ],
            "group": {
                "kind": "build",
            },
        },
        
        // {
        //     "label": "CMake: build all targets",
        //     "type": "cmake",
        //     "command": "build",
        //     "targets": [
        //         "bootloader",
        //         "debug_bringup",
        //         "kernel"
        //     ],
        //     "problemMatcher": [
        //         "$gcc"
        //     ],
        //     "group": {
        //         "kind": "build",
        //         "isDefault": true
        //     }
        // },

        // Tests

        {
            "label": "CMake: build native tests",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "native-tests"
            ],
            "options": {
                "cwd": "${workspaceFolder}/cpu/tests/native"
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: configure native tests"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build MMCSD hardware test",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "mmcsd-hw-test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: configure firmware"
            ],
            "group": {
                "kind": "build"
            }
        },
        
        // -------------------------------------------------------------
        //
        // Run Tests
        //
        // -------------------------------------------------------------

        {
            "label": "CMake: run native tests",
            "type": "process",
            "command": "ctest",
            "args": [
                "--preset",
                "native-tests"
            ],
            "options": {
                "cwd": "${workspaceFolder}/cpu/tests/native"
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake: build native tests"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "test"
            }
        }
        
    ]
}
