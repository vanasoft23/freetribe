@***********************************************************************
@
@ delay.S - Provides routine to accurately delay in CPU cycles.
@ Author: vanasoft23
@
@***********************************************************************

@**************************** Functions ********************************

        .global delay_cycles
        .type delay_cycles, %function

@**************************** Constants ********************************

        

@**************************** Text Section *****************************

        .text
        .cpu arm926ej-s
        .code 32


@***********************************************************************
@*             Function Definition of delay_cycles
@***********************************************************************
delay_cycles:
        SUBS     r0, r0, #1               @ 1 cycle
        BNE      1b                       @ 3 cycles
        BX       lr                       @ 3 cycles
